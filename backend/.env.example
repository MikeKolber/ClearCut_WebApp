# ─────────────────────────────────────────────────────────────────
# ClearCut backend — auth / session config.
#
# Copy this file to `.env` (or export the variables in your shell /
# systemd unit / Docker file) before running `python app.py`. With
# nothing set, the backend boots with the loud-warning defaults
# below (admin / admin) and a per-process random secret key.
# ─────────────────────────────────────────────────────────────────

# Login username. Anything goes — keep it un-guessable if you can.
CC_USERNAME=admin

# bcrypt hash of your password. Generate with:
#   python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass('pw: ').encode(), bcrypt.gensalt()).decode())"
# (paste the resulting $2b$… string below — KEEP THE PLAINTEXT OUT OF THIS FILE)
CC_PASSWORD_HASH=$2b$12$replace_me_with_a_real_bcrypt_hash_............

# Secret key used to sign the session cookie. Any URL-safe string;
# 32+ random bytes is the conventional minimum. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this value invalidates every existing session.
CC_SECRET_KEY=replace_me_with_a_long_random_string

# Session lifetime in hours. After this many hours of *issue time*
# the cookie no longer authenticates and the user is bounced to /login.
CC_SESSION_HOURS=12

# Set to 1 in production (HTTPS) so the browser never sends the
# session cookie over plain HTTP. Leave at 0 in local dev.
CC_COOKIE_SECURE=0

# Comma-separated CORS allow-list. The frontend dev server is at
# http://localhost:3000 by default. In production with a same-origin
# deployment you can leave this unset.
# CC_CORS_ORIGINS=http://localhost:3000


# ─────────────────────────────────────────────────────────────────
# Engine-test storage (Cloudflare R2 / any S3-compatible bucket).
#
# If CC_R2_BUCKET is unset, the backend reads engine-test data from
# the local filesystem (default for `python app.py` on your laptop).
#
# Set ALL the CC_R2_* vars below in production (Render dashboard) to
# read engine-test data from a Cloudflare R2 bucket instead. Layout
# expected in the bucket:
#
#     {prefix}{test_name}/{file_name}
#
# i.e. one "folder" per test, files inside. Drop folders into the
# bucket via the Cloudflare R2 dashboard.
# ─────────────────────────────────────────────────────────────────

# Bucket name (the trigger — when set, R2 mode activates).
# CC_R2_BUCKET=clearcut-engine-tests

# Cloudflare R2 endpoint URL. Find it in the Cloudflare R2 dashboard:
#   "Manage R2 API Tokens" → "API Endpoint"
# Looks like: https://<account-id>.r2.cloudflarestorage.com
# CC_R2_ENDPOINT=https://abc123def456.r2.cloudflarestorage.com

# R2 access key + secret. Generate via:
#   Cloudflare R2 → Manage R2 API Tokens → Create API Token →
#   permissions "Object Read & Write" scoped to the bucket above.
# CC_R2_ACCESS_KEY_ID=replace_me
# CC_R2_SECRET_ACCESS_KEY=replace_me

# Optional path prefix inside the bucket. Leave empty if test folders
# sit at the bucket root (recommended). Set this only if you're
# sharing the bucket with other apps.
# CC_R2_PREFIX=
