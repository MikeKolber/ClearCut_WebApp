# ── Runtime / generated outputs (do not commit) ─────────────────
# 196 MB single CSV regenerated on every sim run; 555 MB of debris
# runs; both are reproducible from the code, so we keep them off
# git rather than blowing past the 100 MB-per-file limit.
physics_engines/core/Trajectory Simulation/output/
physics_engines/core/Trajectory Simulation/debris_data/
# Per-session workspaces + shared preset library the backend creates at
# runtime (CC_DATA_DIR defaults to the Trajectory Simulation folder in
# local dev; in production these live on the Render disk at /var/data).
physics_engines/core/Trajectory Simulation/sessions/
physics_engines/core/Trajectory Simulation/shared/
backend/__pycache__/
backend/.compare_cache/

# ── physics_engines: large data + regenerated artefacts ─────────
# Engine test recordings (multi-GB binaries, only on local disk).
physics_engines/core/Engine Tests/data/**/*.tdms
physics_engines/core/Engine Tests/data/**/*.tdms_index
physics_engines/core/Engine Tests/data/**/*.mp4
physics_engines/core/Engine Tests/data/**/*.avi
physics_engines/core/Engine Tests/data/**/*.mov
physics_engines/core/Engine Tests/data/**/*.mkv
physics_engines/core/Engine Tests/data/**/*.docx

# Pre-loaded Trajectories: large XLSX/CSV reference runs (regenerated by sim).
physics_engines/core/Trajectory Simulation/Pre-loaded Trajectories/*.xlsx
physics_engines/core/Trajectory Simulation/Pre-loaded Trajectories/*.csv

# Stale / regenerated artefacts.
physics_engines/core/Trajectory Simulation/src/debris_trajectory.csv
physics_engines/core/Trajectory Simulation/src/sketch/rocket_structure.pdf
physics_engines/core/Trajectory Simulation/src/sketch/rocket_structure.png
physics_engines/core/Trajectory Simulation/json_files/json_debris/

# CEA binary artefacts.
physics_engines/core/PBS/RocketMassCalc/helpers/CEA/*.out
physics_engines/core/PBS/RocketMassCalc/helpers/CEA/*.plt
physics_engines/core/PBS/RocketMassCalc/test/CEA_Input_File.out
physics_engines/core/PBS/RocketMassCalc/test/CEA_Input_File.plt

